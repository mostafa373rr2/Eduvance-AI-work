# ==============================================================================
# Eduvance AI - Environment Configuration Template
# From the repository root: Copy-Item Backend/.env.example .env
# Run backend commands from the repository root; .env and relative paths use it.
# Environment variables use the same EDUVANCE_ names and override this file.
# ==============================================================================

EDUVANCE_PROJECT_NAME="Eduvance AI"
EDUVANCE_ENVIRONMENT="development"
EDUVANCE_DEBUG=True
EDUVANCE_API_V1_STR="/api/v1"

# Database Configuration (Defaults to SQLite for local development; supports PostgreSQL in production)
# SQLite: sqlite:///./Database/eduvance.db
# PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/eduvance_db
EDUVANCE_DATABASE_URL="sqlite:///./Database/eduvance.db"

# Local Storage Directory
EDUVANCE_STORAGE_DIR="./Backend/storage"
EDUVANCE_MAX_UPLOAD_SIZE_MB=50

# Security & JWT Token Authentication
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Authentication returns 503 until a non-placeholder key of at least 32 bytes is set.
EDUVANCE_SECRET_KEY=""
EDUVANCE_ALGORITHM="HS256"
EDUVANCE_ACCESS_TOKEN_EXPIRE_MINUTES=1440
